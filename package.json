{
  "name": "tenrounds",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --conditions=development --env-file-if-exists=.env server/index.js --dev",
    "start": "node --env-file-if-exists=.env server/index.js",
    "build": "react-router build && vite build --config vite.qa.config.js",
    "preview": "npm run start",
    "lint": "eslint app src server *.config.js tools/test-*.mjs",
    "test:unit": "node tools/test-engine.mjs && node --test tools/test-session.mjs tools/test-room-session.mjs tools/test-multiplayer.mjs",
    "test": "npm run test:unit && npm run build && node --test tools/test-app.mjs tools/test-dev.mjs",
    "test:ui": "python tools/verify_themes.py",
    "test:multiplayer:ui": "python tools/verify_multiplayer.py"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@react-router/express": "8.5.3",
    "@react-router/node": "8.5.3",
    "express": "5.3.0",
    "isbot": "5.2.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.3",
    "ws": "8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@react-router/dev": "8.5.3",
    "@tailwindcss/vite": "4.3.5",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "tailwindcss": "4.3.5",
    "vite": "8.4.0"
  }
}
