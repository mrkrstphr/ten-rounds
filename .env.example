# Optional Node runtime settings. npm start/dev load .env if it exists.
# HOST=127.0.0.1
# PORT=3000
# ROOM_DATA_DIR=./rooms.local

# Exact public origins, comma-separated, no path/trailing slash.
# Set this behind a reverse proxy. It covers both HTTP actions and WebSockets.
# When unset, requests must have an Origin matching the request Host.
# ALLOWED_ORIGINS=https://cards.example.com

# Compose-only host binding. Keep loopback for a reverse proxy on this host.
# Set a specific LAN address when a NAS proxy runs on another machine.
# BIND_ADDRESS=127.0.0.1
